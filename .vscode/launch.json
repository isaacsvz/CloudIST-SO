{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (Make)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cloudIST",
            "args": [
                "3",
                "100",
                "500",
                "60",
                "teste/"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "make build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}